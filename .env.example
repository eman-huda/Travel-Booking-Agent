# ---------------------------------------------------------------
# AI Travel Agent Testbed - environment template
# Copy this file to .env and fill in your own values.
# Never commit .env.
# ---------------------------------------------------------------

# LLM provider: openai (default), ollama, or stub (offline, deterministic, no key)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_key_here
LLM_MODEL=your_selected_model

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Failure injection default for API / CLI runs (the UI has its own control)
FAILURE_MODE=none

# Recovery policy
MAX_TOOL_RETRIES=1
MAX_TOTAL_RETRIES=6
TOOL_TIMEOUT_SECONDS=5
INJECTED_TIMEOUT_DELAY_SECONDS=0.5
STALE_DATA_MAX_AGE_HOURS=24

# Optional read-only real data providers (no API key required).
# mock keeps everything offline. If a real provider fails, the tool reports an error.
WEATHER_PROVIDER=mock          # mock | open_meteo
EXCHANGE_PROVIDER=mock         # mock | open_er_api

LOG_LEVEL=INFO
