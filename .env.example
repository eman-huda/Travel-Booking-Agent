# ---------------------------------------------------------------
# AI Travel Agent Testbed - environment template
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------

# Travel data
#   live = real data: Google Flights and Google Hotels via SerpApi, plus free keyless
#          sources for weather, exchange rates, airports and destination information
#   mock = local sample data (offline, fully reproducible)
# Bookings are ALWAYS simulated in a sandbox, in both modes.
DATA_MODE=live
SERPAPI_API_KEY=your_key_here
SERPAPI_GL=pk                  # Google country for results
LIVE_CACHE_TTL_HOURS=6         # reuse identical live searches for this long (saves quota); 0 disables

# LLM provider: groq (free key), openai, ollama (local), or stub (offline, no key)
LLM_PROVIDER=groq
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=your_key_here
LLM_MODEL=your_selected_model

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Failure injection default for API / CLI runs (the UI has its own control)
FAILURE_MODE=none

# Recovery policy
MAX_TOOL_RETRIES=1
MAX_TOTAL_RETRIES=6
TOOL_TIMEOUT_SECONDS=30
INJECTED_TIMEOUT_DELAY_SECONDS=0.5
STALE_DATA_MAX_AGE_HOURS=24

LOG_LEVEL=INFO
